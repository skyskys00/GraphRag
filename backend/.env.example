# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 建图/抽取用模型（便宜优先）
EXTRACT_MODEL=deepseek-v4-flash
# 回答用模型（可更强）
QUERY_MODEL=deepseek-v4-flash

# 本地 embedding 模型（sentence-transformers 模型 id）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# M1 图片语义增强（多模态，复用上面的 DEEPSEEK_* 凭据；见 docs/modules/MULTIMODAL.md）
VISION_ENABLED=true
VISION_MODEL=deepseek-flash   # DeepSeek-V4.1-Flash，input_modalities 含 image
VISION_MIN_AREA=10000         # px²，成本兜底：小于此面积不调模型（滤小图标）